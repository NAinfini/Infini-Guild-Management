{
  "name": "infini-guild-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "pnpm db:mock:rebuild && concurrently --kill-others-on-fail -n worker,portal,seed \"pnpm dev:worker\" \"pnpm dev:portal\" \"pnpm db:mock:seed\"",
    "dev:all": "concurrently -k -n worker,portal -c yellow,cyan \"pnpm dev:worker\" \"pnpm dev:portal\"",
    "dev:portal": "vite --config apps/portal/vite.config.ts",
    "preview": "vite preview --config apps/portal/vite.config.ts",
    "build": "vite build --config apps/portal/vite.config.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.jsonc",
    "deploy:staging": "wrangler deploy --config apps/worker/wrangler.jsonc --env staging",
    "typecheck:shared": "tsc --noEmit -p tsconfig.json",
    "typecheck:portal": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "tsx apps/worker/tests/integration-smoke.ts",
    "test:worker": "concurrently -k -s first -n worker,test \"pnpm dev:worker\" \"node apps/worker/tests/run-seeded-tests.cjs\"",
    "smoke:pages": "concurrently -k -s first -n worker,portal,smoke \"pnpm dev:worker\" \"pnpm dev:portal\" \"node apps/portal/scripts/smoke-key-pages.cjs\"",
    "lint": "eslint apps/portal apps/worker",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config apps/worker/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/worker/drizzle.config.ts",
    "db:mock:init": "wrangler d1 migrations apply guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "db:mock:seed": "node apps/worker/scripts/seed-local-d1.mjs",
    "db:mock:status": "wrangler d1 execute guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name;\"",
    "db:mock:migrations": "wrangler d1 execute guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT id, name, applied_at FROM d1_migrations ORDER BY id;\"",
    "db:mock:reset": "node apps/worker/scripts/reset-local-d1.mjs",
    "db:mock:rebuild": "pnpm db:mock:reset && pnpm db:mock:init"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gfazioli/mantine-split-pane": "^3.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/carousel": "^8.3.16",
    "@mantine/core": "^8.3.16",
    "@mantine/dropzone": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantine/modals": "^8.3.16",
    "@mantine/notifications": "^8.3.16",
    "@mantine/nprogress": "^8.3.16",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-color": "3.22.5",
    "@tiptap/extension-highlight": "3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-task-item": "3.22.5",
    "@tiptap/extension-task-list": "3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-text-style": "3.22.5",
    "@tiptap/extensions": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "embla-carousel": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "hono": "^4.12.15",
    "i18next": "^26.0.8",
    "lowlight": "^3.3.0",
    "mantine-contextmenu": "8.3.13",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  }
}
