{
  "name": "infini-guild-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm db:mock:rebuild && concurrently --kill-others-on-fail -n worker,portal,seed \"pnpm dev:worker\" \"pnpm dev:portal\" \"pnpm db:mock:seed\"",
    "dev:all": "concurrently -k -n worker,portal -c yellow,cyan \"pnpm dev:worker\" \"pnpm dev:portal\"",
    "dev:portal": "vite --config apps/portal/vite.config.ts",
    "preview": "vite preview --config apps/portal/vite.config.ts",
    "build": "vite build --config apps/portal/vite.config.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:admin": "node scripts/create-admin.mjs",
    "config:check": "node scripts/check-worker-config.mjs",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.jsonc",
    "deploy:production": "node scripts/check-worker-config.mjs --env=production && pnpm build && wrangler deploy --config apps/worker/wrangler.jsonc --env production",
    "typecheck:shared": "tsc --noEmit -p tsconfig.json",
    "typecheck:portal": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "tsx apps/worker/tests/integration-smoke.ts",
    "test:worker": "concurrently -k -s first -n worker,test \"pnpm dev:worker\" \"node apps/worker/tests/run-seeded-tests.cjs\"",
    "smoke:pages": "concurrently -k -s first -n worker,portal,smoke \"pnpm dev:worker\" \"pnpm dev:portal\" \"node apps/portal/scripts/smoke-key-pages.cjs\"",
    "lint": "eslint apps/portal apps/worker",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "test": "node scripts/run-vitest.mjs run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "db:generate": "drizzle-kit generate --config apps/worker/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/worker/drizzle.config.ts",
    "db:mock:init": "wrangler d1 migrations apply guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "db:mock:seed": "node apps/worker/scripts/seed-local-d1.mjs",
    "db:mock:status": "wrangler d1 execute guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name;\"",
    "db:mock:migrations": "wrangler d1 execute guild-portal-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT id, name, applied_at FROM d1_migrations ORDER BY id;\"",
    "db:mock:reset": "node apps/worker/scripts/reset-local-d1.mjs",
    "db:mock:rebuild": "pnpm db:mock:reset && pnpm db:mock:init"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@mantine/carousel": "^8.3.16",
    "@mantine/core": "^8.3.16",
    "@mantine/dropzone": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantine/modals": "^8.3.16",
    "@mantine/notifications": "^8.3.16",
    "@mantine/nprogress": "^8.3.16",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-details": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-youtube": "3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "embla-carousel": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "hono": "^4.12.33",
    "i18next": "^26.3.6",
    "lowlight": "^3.3.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260731.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.113.0"
  }
}
