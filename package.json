{
  "name": "infini-guild-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "concurrently -k -n worker,portal \"pnpm dev:worker\" \"pnpm dev:portal\"",
    "dev:all": "concurrently -k -n worker,portal -c yellow,cyan \"pnpm dev:worker\" \"pnpm dev:portal\"",
    "dev:portal": "vite --config apps/portal/vite.config.ts",
    "preview": "vite preview --config apps/portal/vite.config.ts",
    "build": "vite build --config apps/portal/vite.config.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.jsonc",
    "dev:bot": "tsx watch apps/bot-runtime/index.ts",
    "start:bot": "tsx apps/bot-runtime/index.ts",
    "build:bot": "tsc --noEmit -p tsconfig.json",
    "typecheck:shared": "tsc --noEmit -p tsconfig.json",
    "typecheck:portal": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "typecheck:bot": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "tsx apps/worker/tests/integration-smoke.ts",
    "test:worker": "concurrently -k -s first -n worker,test \"pnpm dev:worker\" \"node apps/worker/tests/run-seeded-tests.cjs\"",
    "smoke:pages": "concurrently -k -s first -n worker,portal,smoke \"pnpm dev:worker\" \"pnpm dev:portal\" \"node apps/portal/scripts/smoke-key-pages.cjs\"",
    "lint": "eslint apps/portal apps/worker",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config apps/worker/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/worker/drizzle.config.ts",
    "db:mock:init": "wrangler d1 migrations apply infini-guild-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state",
    "db:mock:seed": "node apps/worker/scripts/seed-local-d1.mjs",
    "db:mock:status": "wrangler d1 execute infini-guild-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name;\"",
    "db:mock:migrations": "wrangler d1 execute infini-guild-db --local --config apps/worker/wrangler.jsonc --persist-to apps/worker/.wrangler/state --command \"SELECT id, name, applied_at FROM d1_migrations ORDER BY id;\"",
    "db:mock:reset": "node apps/worker/scripts/reset-local-d1.mjs",
    "db:mock:rebuild": "pnpm db:mock:reset && pnpm db:mock:init"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gfazioli/mantine-split-pane": "^3.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@mantine/carousel": "^8.3.16",
    "@mantine/core": "^8.3.16",
    "@mantine/dates": "^8.3.16",
    "@mantine/dropzone": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantine/modals": "^8.3.16",
    "@mantine/notifications": "^8.3.16",
    "@mantine/nprogress": "^8.3.16",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-router": "^1.98.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.10.8",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "@tiptap/suggestion": "^2.27.2",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "discord.js": "^14.18.0",
    "dompurify": "^3.2.4",
    "drizzle-orm": "^0.39.2",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "embla-carousel": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "hono": "^4.7.2",
    "i18next": "^24.2.2",
    "lowlight": "^2.9.0",
    "mantine-contextmenu": "8.3.13",
    "motion": "^12.23.24",
    "nanoid": "^5.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "swiper": "^11.2.4",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "optionalDependencies": {
    "wechaty": "^1.20.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.0.18",
    "wrangler": "^3.107.2"
  }
}
