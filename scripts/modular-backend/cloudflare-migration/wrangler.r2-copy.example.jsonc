{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "replace-with-temporary-r2-copy-worker-name",
  "main": "r2-copy-worker.mjs",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "SOURCE",
      "bucket_name": "replace-with-existing-source-bucket-name"
    },
    {
      "binding": "TARGET",
      "bucket_name": "replace-with-new-target-bucket-name"
    }
  ]
  // Deploy with --var MIGRATION_ACCESS_KEY:<random-64-hex-key>; never place the key here.
}
