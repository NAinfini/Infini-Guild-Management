# Copied to apps/vps/.env by `pnpm setup:local --runtime vps`.
IG_PUBLIC_URL=http://127.0.0.1:8787
IG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IG_SESSION_COOKIE_NAME=ig_session
IG_PBKDF2_ITERATIONS=10000
# Optional OAuth providers. Configure each ID/secret pair together; never put real values in this template.
# IG_OAUTH_GOOGLE_CLIENT_ID=
# IG_OAUTH_GOOGLE_CLIENT_SECRET=
# IG_OAUTH_DISCORD_CLIENT_ID=
# IG_OAUTH_DISCORD_CLIENT_SECRET=
# IG_OAUTH_KOOK_CLIENT_ID=
# IG_OAUTH_KOOK_CLIENT_SECRET=
# IG_OAUTH_WECHAT_APP_ID=
# IG_OAUTH_WECHAT_APP_SECRET=
# Optional Cloudflare Email Sending REST API. All three values are required together.
# IG_EMAIL_FROM=
# IG_CLOUDFLARE_EMAIL_ACCOUNT_ID=
# IG_CLOUDFLARE_EMAIL_API_TOKEN=
IG_HOST=127.0.0.1
IG_PORT=8787
IG_DATABASE_PATH=data/infini-guild.sqlite
IG_BLOB_PATH=data/blobs
IG_STATIC_PATH=apps/portal/dist
# Only exact proxy IPs you operate. This trusted identity scopes authentication rate limits.
IG_TRUSTED_PROXY_IPS=
IG_MAINTENANCE_MODE=off
# Optional public maintenance metadata. The deadline must use UTC canonical ISO format:
# IG_MAINTENANCE_REASON=Database maintenance
# IG_MAINTENANCE_UNTIL=2026-08-30T12:00:00.000Z
