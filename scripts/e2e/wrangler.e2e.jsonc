{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "infini-guild-e2e",
  "main": "../../apps/cloudflare/dist/worker.mjs",
  "compatibility_date": "2026-07-28",
  // The worker resolves the per-request ExecutionContext through
  // AsyncLocalStorage; without this flag workerd refuses to load the bundle.
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "../../apps/portal/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infini-guild-e2e",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/persistence-sqlite/src/migrations/generated",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "infini-guild-e2e-blobs",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "CloudflareNotificationDurableObject"
      },
      {
        "name": "AUTH_LOGIN_RATE_LIMITER",
        "class_name": "AuthRateLimitDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "notifications-v1",
      "new_sqlite_classes": ["CloudflareNotificationDurableObject"]
    },
    {
      "tag": "auth-login-rate-limit-v1",
      "new_sqlite_classes": ["AuthRateLimitDO"]
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "9001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AUTH_IP_RATE_LIMITER",
      "namespace_id": "9007",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "READ_RATE_LIMITER",
      "namespace_id": "9002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CONTENT_VIEW_RATE_LIMITER",
      "namespace_id": "9008",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "9003",
      "simple": { "limit": 80, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "9004",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "WEBSOCKET_RATE_LIMITER",
      "namespace_id": "9005",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "EXPENSIVE_READ_RATE_LIMITER",
      "namespace_id": "9006",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "vars": {
    "IG_PUBLIC_URL": "http://127.0.0.1:8787",
    "IG_ALLOWED_ORIGINS": "http://127.0.0.1:8787",
    "IG_SESSION_COOKIE_NAME": "ig_session",
    "IG_PBKDF2_ITERATIONS": "10000"
  }
}
