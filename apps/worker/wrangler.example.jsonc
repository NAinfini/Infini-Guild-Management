{
  "name": "infini-guild-worker",
  "main": "index.ts",
  "alias": {
    "@guild/shared": "../shared/index.ts",
    "@guild/shared/*": "../shared/*"
  },
  "compatibility_date": "2026-07-01",
  "secrets": {
    "required": ["SIGNING_SECRET"]
  },
  // Static assets are served through the Worker so the SPA shell can receive
  // runtime site metadata. Keep placement local to the visitor; Smart Placement
  // can move asset binding reads away from China users and increase latency.
  "assets": {
    "directory": "../portal/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PORTAL_ORIGIN": "http://localhost:5173",
    "SITE_LOGO_URL": "/guild-logo.svg"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guild-portal-db",
      "database_id": "local-dev",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "guild-portal-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WS",
        "class_name": "WebSocketDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebSocketDO"]
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/15 * * * *"
    ]
  },

  // ── Production environment ──────────────────────────────────────────
  // Start with workers.dev so a custom domain is optional.
  // Deploy with: pnpm deploy:production
  "env": {
    "production": {
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      },
      // For a custom domain managed by Cloudflare, change workers_dev to false
      // and uncomment the next line:
      // "routes": [{ "pattern": "guild.example.com", "custom_domain": true }],
      "secrets": {
        "required": ["SIGNING_SECRET"]
      },
      "assets": {
        "directory": "../portal/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Same-origin deployments can leave this empty. Set it only when a
        // separately hosted portal must call this Worker.
        "PORTAL_ORIGIN": "",
        // Keep production in report mode until the first full media-reference
        // scan has been reviewed. Change to "delete" only after that review.
        // Password-hashing cost for new hashes and login rehashes. The default
        // (10000) fits the Workers free-plan CPU budget; on a paid plan raise it
        // (OWASP recommends 600000 for PBKDF2-SHA256). Existing accounts upgrade
        // to the new cost automatically on their next login.
        // "PBKDF2_ITERATIONS": "600000",
        "SITE_LOGO_URL": "/guild-logo.svg"
      },
      // Placeholders are lowercase-with-hyphens on purpose: `wrangler deploy
      // --dry-run` enforces resource-name syntax, so they must be shaped like
      // real names while config:check still recognizes them as unresolved.
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "your-r2-bucket-name"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-d1-database-name",
          "database_id": "your-d1-database-id",
          "migrations_dir": "db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WS",
            "class_name": "WebSocketDO"
          }
        ]
      }
    }
  }
}
