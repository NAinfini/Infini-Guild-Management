{
  "name": "infini-guild-worker",
  "main": "index.ts",
  "alias": {
    "@guild/shared": "../shared/index.ts",
    "@guild/shared/*": "../shared/*"
  },
  "compatibility_date": "2025-01-01",
  "secrets": {
    "required": ["SIGNING_SECRET"]
  },
  // Static assets are served through the Worker so the SPA shell can receive
  // runtime site metadata. Keep placement local to the visitor; Smart Placement
  // can move asset binding reads away from China users and increase latency.
  "assets": {
    "directory": "../portal/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PORTAL_ORIGIN": "http://localhost:5173",
    "SITE_NAME": "My Guild",
    "SITE_LOGO_URL": "/guild-logo.webp"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guild-portal-db",
      "database_id": "local-dev",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "guild-portal-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WS",
        "class_name": "WebSocketDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebSocketDO"]
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/15 * * * *"
    ]
  },

  // ── Production environment ──────────────────────────────────────────
  // Start with workers.dev so a custom domain is optional.
  // Deploy with: pnpm deploy:production
  "env": {
    "production": {
      "workers_dev": true,
      // For a custom domain managed by Cloudflare, change workers_dev to false
      // and uncomment the next line:
      // "routes": [{ "pattern": "guild.example.com", "custom_domain": true }],
      "secrets": {
        "required": ["SIGNING_SECRET"]
      },
      "assets": {
        "directory": "../portal/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Same-origin deployments can leave this empty. Set it only when a
        // separately hosted portal must call this Worker.
        "PORTAL_ORIGIN": "",
        "SITE_NAME": "My Guild",
        "SITE_LOGO_URL": "/guild-logo.webp"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "YOUR_R2_BUCKET_NAME"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "YOUR_D1_DATABASE_NAME",
          "database_id": "YOUR_D1_DATABASE_ID",
          "migrations_dir": "db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WS",
            "class_name": "WebSocketDO"
          }
        ]
      }
    },

    // ── Staging environment ────────────────────────────────────────────
    // Deploy with: pnpm deploy:staging
    "staging": {
      "workers_dev": true,
      "secrets": {
        "required": ["SIGNING_SECRET"]
      },
      "assets": {
        "directory": "../portal/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "PORTAL_ORIGIN": "",
        "SITE_NAME": "My Guild Staging",
        "SITE_LOGO_URL": "/guild-logo.webp"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "YOUR_STAGING_R2_BUCKET_NAME"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "YOUR_STAGING_D1_DATABASE_NAME",
          "database_id": "YOUR_STAGING_D1_DATABASE_ID",
          "migrations_dir": "db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WS",
            "class_name": "WebSocketDO"
          }
        ]
      }
    }
  }
}
