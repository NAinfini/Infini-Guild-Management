{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vite/client", "@cloudflare/workers-types"],
    "paths": {
      "@portal": ["./apps/portal"],
      "@portal/*": ["./apps/portal/*"],
      "@guild/shared": ["./apps/shared"],
      "@guild/shared/*": ["./apps/shared/*"],
      "@tabler/icons-react": ["./node_modules/@tabler/icons-react"],
      "@tanstack/react-table": ["./node_modules/@tanstack/react-table"],
      "@tiptap/*": ["./node_modules/@tiptap/*"],
      "@mantine/carousel": ["./node_modules/@mantine/carousel"],
      "@dnd-kit/*": ["./node_modules/@dnd-kit/*"],
      "react-hook-form": ["./node_modules/react-hook-form"],
      "@hookform/resolvers/*": ["./node_modules/@hookform/resolvers/*"],
      "zod": ["./node_modules/zod"],
      "dompurify": ["./node_modules/dompurify"],
      "lowlight": ["./node_modules/lowlight"],
      "cmdk": ["./node_modules/cmdk"]
    },
    "noEmit": true
  },
  "include": [
    "apps/ambient.d.ts",
    "apps/shared/**/*.ts",
    "apps/portal/**/*.ts",
    "apps/portal/**/*.tsx",
    "apps/portal/vite.config.ts",
    "apps/worker/**/*.ts",
    "apps/worker/drizzle.config.ts"
  ]
}
